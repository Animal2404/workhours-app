# 依赖与构建产物
node_modules/
dist/
dist-ssr/

# Android 平台由 CI 用 `npx cap add android` 现场生成，不入库。
# 开头的 / 很重要：只忽略仓库根下的 android/，
# 否则 assets/android/（要提交的图标资产）会被一起忽略掉。
/android/
/ios/

# Capacitor 生成的资源
.capacitor/

# 签名文件默认不入库
*.jks
*.keystore
release.keystore

# 例外：signing/workhours.keystore 是刻意提交的「固定调试签名」。
# 目的：每次 CI 构建都用同一把钥匙签名，新 APK 能直接覆盖安装旧版，
# 不会因为签名不一致而要求卸载重装（那会清掉本地工时数据）。
# 注意：它是公开的，所以这个包只能自己装/侧载，不要用于应用商店发布。
!signing/workhours.keystore

# 本地环境
.env
.env.local
.env.*.local

# 验证脚本产出的截图（本地核对用）
shots/
.tmp/

# 编辑器与系统
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
*.swp
*.log
npm-debug.log*

# 其它
out/
coverage/
*.tsbuildinfo
